Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0

    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR (Velodyne)
      Enabled: true
      Topic:
        Value: /velodyne_points
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Color Transformer: AxisColor
      Axis: Z
      Color: 255; 255; 255
      Style: Points
      Size (Pixels): 2

    - Class: rviz_default_plugins/PointCloud2
      Name: SLAM Map Cloud
      Enabled: true
      Topic:
        Value: /rtabmap/cloud_map
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2

    - Class: rviz_default_plugins/Map
      Name: Occupancy Grid
      Enabled: true
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Alpha: 0.7
      Color Scheme: map

    - Class: rviz_default_plugins/Odometry
      Name: Odometry (ICP)
      Enabled: true
      Topic:
        Value: /odom
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Keep: 50
      Shape:
        Alpha: 1
        Axes Length: 0.3
        Axes Radius: 0.02

    - Class: rviz_default_plugins/Path
      Name: SLAM Path
      Enabled: true
      Topic:
        Value: /rtabmap/mapPath
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Color: 255; 0; 0
      Line Width: 0.03

    - Class: rviz_default_plugins/Image
      Name: ZED Right (Primary)
      Enabled: true
      Topic:
        Value: /zed_right/zed_node/rgb/image_rect_color
        Depth: 2
        Durability Policy: Volatile
        Reliability Policy: Best Effort

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Pitch: 0.9
      Target Frame: base_link
      Yaw: 0.0
      Name: 3D View
